# --- Twitch (required for live data) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DYNASTY_GAME_NAME=EA Sports College Football 27

# --- Admin secrets: REQUIRED to edit scores/finals. No defaults exist in the code. ---
# The old defaults ("SYBAU" and "gameday") were public in the repo, so pick NEW values.
SUBMIT_PASSWORD=
ADMIN_KEY=

# --- Score reader (needs the Docker image: ffmpeg + tesseract + streamlink) ---
SCORE_ENABLED=1
DATA_DIR=/data
# Optional tuning (defaults shown)
# SCORE_SECONDS=25
# SCORE_GRAB_ATTEMPTS=16
# SCORE_JUMP_CONFIRM=2        # cycles an implausible score jump must repeat before it is believed
# SCORE_FINAL_CYCLES=2        # cycles of FINAL on the bug that end a game
# SCORE_NEW_GAME_CONFIRM=2    # cycles of new teams + a score/quarter reset that start a new game
# SCORE_GAME_MERGE_HOURS=4    # two streams of one matchup inside this window are one final

# --- Discord pings (optional) ---
# DISCORD_WEBHOOK_URL=
# DISCORD_MENTION=@here
